{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @huphup/backend build",
    "watchPatterns": ["apps/backend/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @huphup/backend run prisma:deploy && pnpm --filter @huphup/backend run start:prod",
    "healthcheckPath": "/api/v1/health/live",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
