generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries: pooled connection (Neon PgBouncer) in the cloud.
  url       = env("DATABASE_URL")
  // Migrations: must bypass the pooler — PgBouncer can't run them. Locally set
  // this to the same value as DATABASE_URL; plain Postgres serves both.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  BUYER
  SUPPLIER
  ADMIN
}

enum RequestStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum LeadStatus {
  NEW
  VIEWED
  OFFERED
  SKIPPED
}

enum LeadActivityType {
  CREATED
  VIEWED
  CLAIMED
  REASSIGNED
  STATUS_CHANGED
  OFFER_SENT
  SKIPPED
  NOTE_ADDED
  NEXT_STEP_SET
}

enum ConversationType {
  REQUEST_CHAT
  DIRECT
}

enum NotificationType {
  NEW_OFFER
  OFFER_ACCEPTED
  NEW_LEAD
  NEW_MESSAGE
  REQUEST_PUBLISHED
  LOW_BALANCE
  BILLING
  SYSTEM
}

enum CompanyMemberRole {
  OWNER
  MANAGER
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  avatarKey    String?
  role         UserRole  @default(BUYER)
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company           Company?
  buyerRequests     Request[]            @relation("BuyerRequests")
  offers            Offer[]
  memberships       ConversationMember[]
  messages          Message[]
  notifications     Notification[]
  companyMembers    CompanyMember[]
  createdInvites    CompanyInvite[]      @relation("InviteCreator")
  usedInvites       CompanyInvite[]      @relation("InviteUser")
  passwordResets    PasswordResetToken[]
  productReviews    ProductReview[]
  assignedLeads     Lead[]               @relation("LeadAssignee")
  actedLeads        Lead[]               @relation("LeadLastActor")
  leadActivities    LeadActivity[]
  leadNotes         LeadNote[]
  createdLeadTasks  LeadTask[]           @relation("LeadTaskCreator")
  assignedLeadTasks LeadTask[]           @relation("LeadTaskAssignee")
  leadTaskComments  LeadTaskComment[]
  wallet            Wallet?
  createdWalletTxns WalletTransaction[]  @relation("WalletTxnCreator")
  deals             Deal[]               @relation("DealBuyer")

  @@index([role])
  @@map("users")
}

model Company {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  name        String
  bin         String?
  city        String?
  description String?
  categories  String[] @default([])
  verified    Boolean  @default(false)
  rating      Float    @default(0)
  logoUrl     String?
  logoKey     String?
  taskSeq     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members            CompanyMember[]
  offers             Offer[]
  leads              Lead[]
  products           Product[]
  invites            CompanyInvite[]
  crmStages          CrmStageConfig[]
  crmAutomationRules CrmAutomationRule[]
  leadTasks          LeadTask[]
  wallet             Wallet?
  prices             CompanyPrice[]
  deals              Deal[]

  @@index([city])
  @@index([verified])
  @@map("companies")
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  unit        String?
  priceFrom   Decimal? @db.Decimal(14, 2)
  currency    String   @default("KZT")
  city        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  images  ProductImage[]
  reviews ProductReview[]
  leads   Lead[]

  @@index([companyId, isActive])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String
  storageKey String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@map("product_reviews")
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(MANAGER)
  title     String?
  createdAt DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@unique([userId])
  @@index([companyId, role])
  @@map("company_members")
}

model CompanyInvite {
  id          String            @id @default(cuid())
  token       String            @unique
  companyId   String
  createdById String
  email       String
  role        CompanyMemberRole @default(MANAGER)
  title       String?
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  createdAt   DateTime          @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User?   @relation("InviteUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
  @@map("company_invites")
}

model Request {
  id          String        @id @default(cuid())
  code        String        @unique
  buyerId     String
  title       String
  description String
  category    String?
  city        String?
  quantity    String?
  deadline    String?
  budgetMin   Decimal?      @db.Decimal(14, 2)
  budgetMax   Decimal?      @db.Decimal(14, 2)
  status      RequestStatus @default(DRAFT)
  rawText     String?
  isFavorite  Boolean       @default(false)
  hiddenAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  buyer        User          @relation("BuyerRequests", fields: [buyerId], references: [id], onDelete: Cascade)
  offers       Offer[]
  leads        Lead[]
  attachments  Attachment[]
  conversation Conversation?
  deals        Deal[]

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
  @@index([city])
  @@index([category])
  @@map("requests")
}

model Offer {
  id           String      @id @default(cuid())
  requestId    String
  companyId    String
  authorId     String
  price        Decimal     @db.Decimal(14, 2)
  currency     String      @default("KZT")
  deliveryDays Int?
  comment      String?
  status       OfferStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  deal    Deal?

  @@index([requestId])
  @@index([companyId])
  @@index([status])
  @@map("offers")
}

model Lead {
  id               String     @id @default(cuid())
  requestId        String
  companyId        String
  matchedProductId String?
  score            Float      @default(0)
  status           LeadStatus @default(NEW)
  matchReason      String?
  assigneeId       String?
  claimedAt        DateTime?
  lastActorId      String?
  nextStepAt       DateTime?
  nextStepText     String?
  statusChangedAt  DateTime   @default(now())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  request        Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  matchedProduct Product?       @relation(fields: [matchedProductId], references: [id], onDelete: SetNull)
  assignee       User?          @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  lastActor      User?          @relation("LeadLastActor", fields: [lastActorId], references: [id], onDelete: SetNull)
  activities     LeadActivity[]
  notes          LeadNote[]
  tasks          LeadTask[]

  @@unique([requestId, companyId])
  @@index([companyId, status])
  @@index([assigneeId])
  @@index([statusChangedAt])
  @@index([matchedProductId])
  @@map("leads")
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  userId    String?
  type      LeadActivityType
  message   String
  meta      Json?
  createdAt DateTime         @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

enum LeadTaskKind {
  CALL
  MEETING
  TASK
}

enum LeadTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum LeadTaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model LeadTask {
  id          String           @id @default(cuid())
  companyId   String
  leadId      String
  creatorId   String
  assigneeId  String
  code        String
  kind        LeadTaskKind     @default(TASK)
  status      LeadTaskStatus   @default(TODO)
  priority    LeadTaskPriority @default(MEDIUM)
  title       String
  description String?
  dueAt       DateTime
  doneAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead     Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  creator  User              @relation("LeadTaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee User              @relation("LeadTaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  comments LeadTaskComment[]

  @@unique([companyId, code])
  @@index([leadId, dueAt])
  @@index([assigneeId, status])
  @@index([companyId, status])
  @@map("lead_tasks")
}

model LeadTaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task LeadTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("lead_task_comments")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

model CrmStageConfig {
  id        String     @id @default(cuid())
  companyId String
  status    LeadStatus
  label     String
  sortOrder Int
  color     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, status])
  @@index([companyId, sortOrder])
  @@map("crm_stage_configs")
}

model CrmAutomationRule {
  id        String   @id @default(cuid())
  companyId String
  enabled   Boolean  @default(true)
  trigger   String
  action    String
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, enabled])
  @@map("crm_automation_rules")
}

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType @default(REQUEST_CHAT)
  requestId String?          @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  request  Request?             @relation(fields: [requestId], references: [id], onDelete: SetNull)
  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  isPinned       Boolean   @default(false)
  hiddenAt       DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String
  fileName   String
  fileUrl    String
  storageKey String
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model Attachment {
  id        String   @id @default(cuid())
  requestId String
  fileName  String
  fileUrl   String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("attachments")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  payload   Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model StoredFile {
  id        String   @id @default(cuid())
  fileName  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@map("stored_files")
}

/// Кошелёк одной стороны: компании-поставщика ИЛИ пользователя.
/// Ровно одно из userId/companyId заполнено — проверка CHECK в миграции.
model Wallet {
  id                   String    @id @default(cuid())
  userId               String?   @unique
  companyId            String?   @unique
  balance              Decimal   @default(0) @db.Decimal(14, 2)
  currency             String    @default("KZT")
  lowBalanceNotifiedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

enum BillingReason {
  ESCROW_HOLD
  ESCROW_RELEASE
  ESCROW_REFUND
  LEAD_UNLOCK
  OFFER_SENT
  SUBSCRIPTION
  DEAL_COMMISSION
  MANUAL
}

/// Неизменяемая проводка. type задаёт направление, reason — за что списали.
/// idempotencyKey защищает от двойного списания при повторе запроса.
model WalletTransaction {
  id             String                @id @default(cuid())
  walletId       String
  type           WalletTransactionType
  reason         BillingReason?
  amount         Decimal               @db.Decimal(14, 2)
  balanceAfter   Decimal               @db.Decimal(14, 2)
  idempotencyKey String?               @unique
  comment        String?
  leadId         String?
  offerId        String?
  requestId      String?
  meta           Json?
  createdById    String?
  createdAt      DateTime              @default(now())

  wallet    Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("WalletTxnCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([reason])
  @@map("wallet_transactions")
}

/// Цена платформы по умолчанию для каждого повода списания.
model PlatformPrice {
  id        String        @id @default(cuid())
  reason    BillingReason @unique
  enabled   Boolean       @default(false)
  amount    Decimal       @default(0) @db.Decimal(14, 2)
  percent   Decimal?      @db.Decimal(5, 2)
  currency  String        @default("KZT")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("platform_prices")
}

/// Индивидуальная цена для компании, перекрывает PlatformPrice.
model CompanyPrice {
  id        String        @id @default(cuid())
  companyId String
  reason    BillingReason
  enabled   Boolean       @default(true)
  amount    Decimal       @default(0) @db.Decimal(14, 2)
  percent   Decimal?      @db.Decimal(5, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, reason])
  @@map("company_prices")
}

/// Стадии сейф-сделки. Порядок линейный, назад пути нет:
/// оплата -> отгрузка -> выдача. Спор ставит паузу и решается площадкой.
enum DealStatus {
  AWAITING_PAYMENT
  HELD
  SHIPPED
  RELEASED
  REFUNDED
  DISPUTED
}

/// Сейф-сделка: деньги покупателя лежат у площадки, пока товар не получен.
/// Сумма фиксируется в момент акцепта и дальше не меняется.
model Deal {
  id            String     @id @default(cuid())
  offerId       String     @unique
  requestId     String
  buyerId       String
  companyId     String
  amount        Decimal    @db.Decimal(14, 2)
  /// Удержано площадкой при выдаче; считается по прайсу в момент выпуска.
  commission    Decimal    @default(0) @db.Decimal(14, 2)
  currency      String     @default("KZT")
  status        DealStatus @default(AWAITING_PAYMENT)
  fundedAt      DateTime?
  shippedAt     DateTime?
  /// Отгрузка плюс срок ожидания: после этой даты деньги выходят сами.
  autoReleaseAt DateTime?
  releasedAt    DateTime?
  refundedAt    DateTime?
  disputeReason String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  buyer   User    @relation("DealBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([buyerId, status])
  @@index([companyId, status])
  @@index([status, autoReleaseAt])
  @@map("deals")
}
