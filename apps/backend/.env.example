# Server
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# PostgreSQL — local Docker OR cloud (Neon)
# Local: docker compose up -d
# Neon: paste pooled connection string, append ?sslmode=require if missing
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/huphup?schema=public"

# JWT (use a long random secret in production)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# CORS — comma-separated frontend origins
# Local: http://127.0.0.1:5173
# Production: https://your-app.vercel.app
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# Gemini (Google AI Studio API key) — product matching + request analyze
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# Optional daily cap on prompt+output tokens (UTC day). Once hit, Gemini
# calls are skipped and every caller falls back to the rule-based path
# until midnight UTC. Unset = no cap.
# GEMINI_DAILY_TOKEN_BUDGET="2000000"

# Balance: порог, ниже которого владельцу кошелька уходит уведомление
# о низком остатке (раз в сутки). По умолчанию 5000.
# BILLING_LOW_BALANCE="5000"

# Redis (optional) — enables the Socket.IO adapter so chat works across
# multiple instances. Without it a single instance still works fine.
# REDIS_URL="redis://127.0.0.1:6379"

# S3 file storage (production). Without these, files save to local ./uploads
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="eu-central-1"
# AWS_S3_BUCKET="huphup-uploads"
# AWS_S3_PUBLIC_URL="https://huphup-uploads.s3.eu-central-1.amazonaws.com"
# AWS_S3_ENDPOINT=""  # optional, for Cloudflare R2 / MinIO
