# Server
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Remote PostgreSQL (other machine / cloud) OR local Docker:
# docker compose up -d
# Example: postgresql://USER:PASSWORD@HOST:5432/huphup?schema=public
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/huphup?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# CORS — frontend runs on another device; add its origin(s)
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"

# Optional Redis later
# REDIS_URL="redis://127.0.0.1:6379"
