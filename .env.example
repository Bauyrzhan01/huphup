# Скопируйте в .env и заполните своими значениями:
#   copy .env.example .env

FLASK_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://127.0.0.1:5000

# Neon / Postgres (production). Locally omit to use SQLite in data/.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# PG_POOL_MAX=10
# Коды регистрации (в т.ч. менеджер по invite) хранятся в БД, не в памяти процесса.

# --- Email (подтверждение регистрации + уведомления) ---
# Gmail: включите 2FA → пароль приложения:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.name@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=HupHup <your.name@gmail.com>
SMTP_TLS=1

# Куда слать тестовое письмо: python scripts/email_smoke.py
# EMAIL_SMOKE_TO=your.name@gmail.com
