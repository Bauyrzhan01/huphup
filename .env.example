# Скопируйте в .env и заполните своими значениями:
#   copy .env.example .env

FLASK_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://127.0.0.1:5000

# Neon / Postgres (production). Locally omit to use SQLite in data/.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# PG_POOL_MAX=10
# Коды регистрации (в т.ч. менеджер по invite) хранятся в БД, не в памяти процесса.

# --- Email (подтверждение регистрации + уведомления) ---
# Вариант A — Gmail (2FA → пароль приложения):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.name@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=HupHup <your.name@gmail.com>
SMTP_TLS=1

# Вариант B — Resend (https://resend.com) — удобно на Vercel:
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=HupHup <noreply@your-domain.com>
# (тест: onboarding@resend.dev — только на email аккаунта Resend)

# После заполнения .env на Vercel:
#   python scripts/push_mail_env_vercel.py
#   npx vercel --prod

# Куда слать тестовое письмо: python scripts/email_smoke.py
# EMAIL_SMOKE_TO=your.name@gmail.com
